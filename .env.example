# ---------------------------------------------------------------
# 复制这个文件为 .env，按需修改
# 学生须知：.env 里存的是"环境相关的配置"，比如数据库地址、端口。
# 这些不应该硬编码在代码里，也不应该提交到 git 仓库（.gitignore 已排除）。
# .env.example 是模板，提交到仓库，让每个开发者知道需要哪些变量。
# ---------------------------------------------------------------

# PostgreSQL 连接串
DATABASE_URL=postgres://dev:dev@localhost:5432/webtutor
API_PORT=3000
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# DeepSeek API Key（找 TL 要）
DEEPSEEK_API_KEY=sk-your-key-here

# GLM API Key（智谱 AI）
GLM_API_KEY=your-glm-key-here

# MiniMax API Key
MINIMAX_API_KEY=your-minimax-key-here

# Kimi API Key（月之暗面 Moonshot）
KIMI_API_KEY=your-kimi-key-here

# 默认使用的 AI 模型: deepseek | glm | minimax | kimi
LLM_MODEL=deepseek
